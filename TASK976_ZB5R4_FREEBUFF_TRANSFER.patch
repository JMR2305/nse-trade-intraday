+#!/usr/bin/env python3
+from __future__ import annotations
+import ast, hashlib, json, math, sys, types, unittest
+from pathlib import Path
+from typing import Any, Mapping
+
+# Pure offline reproduction of ZB5 Tier3 timing/evidence logic.
+# NO database, NO network, NO provider/broker access.
+
+FROZEN_ENV = {
+    "PATH": "/usr/bin:/bin",
+    "LANG": "en_US.UTF-8",
+    "LC_ALL": "en_US.UTF-8",
+    "TZ": "UTC",
+    "PYTHONPATH": str(Path(__file__).resolve().parent),
+    "SSL_CERT_FILE": "",
+    "SSL_CERT_DIR": "",
+}
+
+WORKER_PLAN = {1: (252, 75), 2: (252, 75), 3: (504, 75)}
+CANONICAL_HASH = None
+
+def exact_set_hash(symbols: list[str] | tuple[str, ...]) -> str:
+    canonical = "\n".join(sorted({str(s).strip().upper() for s in symbols}))
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
+SYMBOLS = None  # set below
+
+import importlib.util, types as _types
+
+def _load_real_symbols_and_hash():
+    # Extract worker constants by importing the worker module itself. This is
+    # supplemental diagnostic extraction only and does NOT cover the full ZB5
+    # offline suite, which still requires psycopg2 for the fixture gate.
+    spec = importlib.util.spec_from_file_location(
+        "task976_zb5_worker_probe",
+        Path(__file__).resolve().parent / "task976_zb5_worker.py",
+    )
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules["task976_zb5_worker_probe"] = mod
+    # worker.py imports task976_zeabur_fixture which imports psycopg2; prevent
+    # that by pre-populating a stub psycopg2 module.
+    psycopg2_stub = _types.ModuleType("psycopg2")
+    psycopg2_stub.connect = None
+    sys.modules["psycopg2"] = psycopg2_stub
+    sys.path.insert(0, str(Path(__file__).resolve().parent))
+    try:
+        spec.loader.exec_module(mod)
+    finally:
+        sys.path.pop(0)
+        sys.modules.pop("psycopg2", None)
+    return mod.CANONICAL_SYMBOLS, mod.CANONICAL_HASH
+
+SYMBOLS, CANONICAL_HASH = _load_real_symbols_and_hash()
+
+class WorkerSafetyError(RuntimeError): pass
+
+def worker_plan(tier: int) -> tuple[int, int]:
+    try:
+        return WORKER_PLAN[int(tier)]
+    except (KeyError, TypeError, ValueError) as exc:
+        raise WorkerSafetyError("tier must be exactly 1, 2, or 3") from exc
+
+def require_exact_symbols(symbols):
+    normalized = tuple(sorted(str(s).strip().upper() for s in symbols))
+    if normalized != tuple(sorted(SYMBOLS)) or exact_set_hash(normalized) != CANONICAL_HASH:
+        raise WorkerSafetyError("exact symbol set/hash required")
+
+def deterministic_ohlcv(symbol: str, bars: int) -> list[dict[str, Any]]:
+    if not 60 <= int(bars) <= 2000:
+        raise WorkerSafetyError("bars outside 60..2000")
+    seed = int(hashlib.sha256(symbol.upper().encode()).hexdigest()[:12], 16)
+    prior = 40.0 + (seed % 46000) / 100
+    start = __import__("datetime").datetime(2024, 1, 1, tzinfo=__import__("datetime").timezone.utc)
+    rows = []
+    for i in range(int(bars)):
+        close = max(1.0, prior * (1 + 0.00025 + math.sin((i + seed % 31) / 9) * 0.0025))
+        spread = 0.003 + ((seed + i * 17) % 70) / 10000
+        rows.append({
+            "date": (start + __import__("datetime").timedelta(days=i)).isoformat(),
+            "open": round(prior, 6),
+            "high": round(max(prior, close) * (1 + spread), 6),
+            "low": round(min(prior, close) * (1 - spread), 6),
+            "close": round(close, 6),
+            "volume": 100000 + ((seed + i * 7919) % 900000),
+        })
+        prior = close
+    return rows
+
+def rows_hash(value: Any) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"), default=str).encode()).hexdigest()
+
+def run_deterministic_workload(tier: int, *, scan_one) -> dict[str, Any]:
+    bars, _limit = worker_plan(tier)
+    require_exact_symbols(SYMBOLS)
+    started = __import__("time").perf_counter()
+    results = [scan_one(s, bars) for s in SYMBOLS]
+    duration = __import__("time").perf_counter() - started
+    if duration > 75:
+        raise WorkerSafetyError("worker exceeded 75-second bound")
+    call_counts = [int(row.pop("_task976_lab_walk_calls", 0)) for row in results]
+    lab_calls = sum(call_counts)
+    if any(count <= 0 for count in call_counts):
+        raise WorkerSafetyError("_run_lab_walk execution was not proven")
+    return {
+        "tier": tier,
+        "symbols_processed": len(results),
+        "bars_per_symbol": bars,
+        "symbol_hash": CANONICAL_HASH,
+        "result_hash": rows_hash(results),
+        "duration_seconds": duration,
+        "peak_rss_kib": 0,
+        "lab_walk_calls": lab_calls,
+        "provider_calls": 0,
+        "broker_calls": 0,
+        "orders_submitted": 0,
+    }
+
