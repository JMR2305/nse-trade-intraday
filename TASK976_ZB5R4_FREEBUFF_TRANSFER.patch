+    if len(rows) != config.scanner_workers:
+        raise RuntimeError("worker evidence count mismatch")
+    for row in rows:
+        if (
+            row.get("tier") != config.tier
+            or row.get("symbols_processed") != 23
+            or row.get("bars_per_symbol") != expected_bars
+            or row.get("symbol_hash") != CANONICAL_HASH
+            or row.get("provider_calls") != 0
+            or row.get("broker_calls") != 0
+            or row.get("orders_submitted") != 0
+            or not (0 < float(row.get("duration_seconds", -1)) <= 75)
+            or int(row.get("lab_walk_calls", 0)) <= 0
+        ):
+            raise RuntimeError("invalid or unsafe worker evidence")
+
