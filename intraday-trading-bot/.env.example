# ============================================================
# Environment Configuration
# NEVER commit this file with real values
# Copy to .env and fill in your actual credentials
# ============================================================

# --------------------------------------------------
# Application
# --------------------------------------------------
APP_NAME=intraday-trading-bot
APP_ENV=development
DEBUG=false

# --------------------------------------------------
# Database (PostgreSQL with asyncpg)
# --------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/intraday_bot
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/intraday_bot

# --------------------------------------------------
# Internal Operator Authentication (FastAPI JWT)
# Uses HS256 for simplicity. For production, switch to RS256.
# Generate with: openssl rand -hex 64
# --------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_64_character_hex_string_minimum_length
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=7

# --------------------------------------------------
# Zerodha Broker API (read-only skeleton in this phase)
# NEVER use placeholder credentials in production
# --------------------------------------------------
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here

# --------------------------------------------------
# Trading (structurally enforced PAPER mode)
# --------------------------------------------------
TRADING_MODE=PAPER

# --------------------------------------------------
# Logging
# --------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=structured_json

# --------------------------------------------------
# Paper Trading Simulation
# --------------------------------------------------
PAPER_INITIAL_CAPITAL=1000000.00
PAPER_SLIPPAGE_MODEL=realistic

# --------------------------------------------------
# Risk Limits
# --------------------------------------------------
RISK_PER_TRADE_PCT=1.0
MAX_DRAWDOWN_INR=50000.0
DAILY_LOSS_LIMIT_INR=25000.0
PORTFOLIO_HEAT_PCT=15.0
SECTOR_EXPOSURE_PCT=25.0

# --------------------------------------------------
# CORS (comma-separated origins)
# --------------------------------------------------
CORS_ALLOWED_ORIGINS=https://trading-dashboard.yourdomain.com,https://admin.yourdomain.com
