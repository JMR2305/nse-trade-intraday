# Database
DATABASE_URL=sqlite+aiosqlite:///./web_intelligence.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/apexquant_wi

# Snapshot storage
SNAPSHOT_STORAGE_DIR=./snapshots

# Service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO

# Fetching
DEFAULT_USER_AGENT="ApexQuant-WebIntelligence/0.1.0 (+https://apexquant.ai/bot)"
GLOBAL_CONCURRENCY_LIMIT=5
DEFAULT_REQUEST_INTERVAL_SECONDS=5.0
MAXIMUM_RESPONSE_SIZE_BYTES=10485760
REQUEST_TIMEOUT_SECONDS=30.0
RETRY_COUNT=3

# API
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

# Security
ALLOW_HTTP_FOR_TESTS=false
PRODUCTION_MODE=true
