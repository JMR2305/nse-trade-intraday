modules = ["nodejs-24", "python-3.12", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.build]
args = ["bash", "scripts/deploy-build.sh"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm exec tsc -b lib/api-client-react lib/api-zod lib/db artifacts/api-server && pnpm --filter trading-dashboard exec tsc --noEmit && pnpm --filter @workspace/trading-mobile exec tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales"]

[userenv]

[userenv.shared]
PREOPEN_INTELLIGENCE_ENABLED = "true"
PREOPEN_VALIDATION_ENABLED = "True"
SIGNAL_VALIDATION_ENABLED = "false"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 21338
externalPort = 3001

[[ports]]
localPort = 22312
externalPort = 3000

[[ports]]
localPort = 22605
externalPort = 3002

[[ports]]
localPort = 24210
externalPort = 80
