# ============================================================
# NSE Trading Dashboard (ApexQuant AI) — Environment Variables
# ============================================================
#
# Copy this file to .env.local for local overrides.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Never put secrets (API keys, tokens) in VITE_* variables.
#
# ── Required by Replit / Vite dev server ────────────────────
PORT=3000
BASE_PATH=/trading-dashboard

# ── API connectivity ─────────────────────────────────────────
#
# VITE_API_BASE_URL
#   Full base URL of the API server, without a trailing slash.
#   - Leave unset in development on Replit: the app falls back to the
#     relative path "/api", which the Replit proxy routes correctly.
#   - MUST be set in production deployments to an HTTPS URL.
#   - A value containing "localhost" in a production build is a hard error.
#
# Example (production):
#   VITE_API_BASE_URL=https://your-repl.repl.co/api
#
# VITE_WS_BASE_URL
#   Base URL for the SSE (Server-Sent Events) stream endpoint.
#   Defaults to the same origin as VITE_API_BASE_URL when not set.
#   Only override this if the SSE server is on a different origin than the API.
#
# Example:
#   VITE_WS_BASE_URL=https://your-repl.repl.co/api
#
# Uncomment and fill in for production:
# VITE_API_BASE_URL=
# VITE_WS_BASE_URL=

# ── CORS / Allowed origins (backend, not frontend) ──────────
# Comma-separated list of origins that the API server should accept.
# Set this on the API server environment, not here.
# Example: ALLOWED_ORIGINS=https://your-dashboard.repl.co,https://your-mobile.repl.co
